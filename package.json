{
	"name": "sugarshock",
	"private": true,
	"description": "a showcase repository for Twine SugarCube 2",
	"packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
	"scripts": {
		"build": "tweego --format=sugarcube-2 --output index.html --head=src/head-content.html src/twee",
		"build-single": "tweego --format=sugarcube-2 --output index.html src/twee-single",
		"watch": "tweego --format=sugarcube-2 --output index.html --head=src/head-content.html --watch src/twee",
		"gen-asset-index": "b3sum index.html > assets/offline-index.txt && fd -tf -I -g -E 'offline-index.txt' '*' assets -X b3sum >> assets/offline-index.txt"
	},
	"workspaces": [
		"packages/*"
	],
	"devDependencies": {
		"@rollup/plugin-typescript": "^12.3.0",
		"@spectreforge/tiny-jsx2dom": "workspace:^",
		"@types/node": "~22",
		"@types/serviceworker": "^0.0.172",
		"@types/twine-sugarcube": "~2.37.2",
		"prettier": "^3.9.9",
		"typescript": "~6.0.3"
	}
}
